{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Debug Train",
      "request": "launch",
      "mainClass": "com.toyllm.Main",
      "projectName": "java-toy-llm",
      "args": "train",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "shortenCommandLine": "auto",
      "env": {
        "JAVA_HOME": "/Library/Java/JavaVirtualMachines/temurin-25.jdk/Contents/Home"
      }
    },
    {
      "type": "java",
      "name": "Debug Generate",
      "request": "launch",
      "mainClass": "com.toyllm.Main",
      "projectName": "java-toy-llm",
      "args": "generate Once upon",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "shortenCommandLine": "auto",
      "env": {
        "JAVA_HOME": "/Library/Java/JavaVirtualMachines/temurin-25.jdk/Contents/Home"
      }
    },
    {
      "type": "java",
      "name": "Debug Main (no args)",
      "request": "launch",
      "mainClass": "com.toyllm.Main",
      "projectName": "java-toy-llm",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "shortenCommandLine": "auto"
    },
    {
      "type": "java",
      "name": "Attach to JVM",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005
    }
  ]
}
